# Application Environment Variables
PORT=4000
SPRING_PROFILES_ACTIVE=dev

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hms_db
DB_USERNAME=hms
DB_PASSWORD=hms_password_123

# JWT Authentication
# REQUIRED for production (and every non-dev/test profile). Minimum 32 characters (256 bits).
# Generate a unique value, e.g.: openssl rand -base64 48
# The value below is the development placeholder only — it is rejected outside dev/test.
JWT_SECRET=supersecretjwtkeythatmustbechangedinproductionandhasatleast256bitslength
JWT_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_COOKIE_SECURE=false

# Security & Reverse Proxy
TRUST_PROXY_HEADERS=false


# Mailhog / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
