{
  "name": "hospital-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Hospital Management System modelled on Aster Hospitals (UAE)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "node scripts/infra-up.js",
    "infra:down": "docker compose down",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:api": "node scripts/run-mvn.js test",
    "dev:api": "node scripts/run-mvn.js spring-boot:run -Dspring-boot.run.profiles=dev",
    "dev:web-public": "npm run dev --workspace=apps/web-public",
    "dev:web-patient": "npm run dev --workspace=apps/web-patient",
    "dev:web-staff": "npm run dev --workspace=apps/web-staff",
    "dev:web": "concurrently \"npm run dev:web-public\" \"npm run dev:web-patient\" \"npm run dev:web-staff\"",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
